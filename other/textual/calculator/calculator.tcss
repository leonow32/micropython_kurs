Grid {
    grid-size: 4 5;             # 4 kolumny, 5 wierszy
    grid-gutter: 1 2;
    margin: 1;
}

Digits {
    width: 100%;
    height: 5;
    background: $boost;
    text-align: center;
    margin: 1;
}

Button {
    width: 100%;
    height: 3;

    &#number-0 {                # Dotyczny przycisku, który ma id number-0
        column-span: 2;
    }
}

